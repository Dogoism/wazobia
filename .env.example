# Supabase configuration. When absent, the app runs on typed mock data.
# The anon key is safe for the browser by design; access control is
# enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client, never commit a real value.
# Not read by the app today; reserved for operator tooling (e.g. granting
# reviewer status, inserting labeled AI suggestions).
# SUPABASE_SERVICE_ROLE_KEY=
